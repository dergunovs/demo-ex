{
  "name": "driverf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace backend",
    "dev:client": "npm run dev --workspace frontend",
    "ts": "npm run ts --workspace backend && npm run ts --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "10.0.5"
  },
  "allowScripts": {
    "vue-demi": true
  }
}
